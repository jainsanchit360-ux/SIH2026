# ==============================================================================
# ResQtech Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local environment.
# ==============================================================================

# General Application Settings
APP_NAME=ResQtech
APP_ENV=development
DEBUG=True

# Data Directory Paths (Relative to project root or absolute paths)
DATA_RAW_DIR=data/raw
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
DATA_SAMPLES_DIR=data/samples

# Geospatial Subdirectories
GSI_DATA_DIR=data/raw/gsi
DEM_DATA_DIR=data/raw/dem
RAINFALL_DATA_DIR=data/raw/rainfall
SMAP_DATA_DIR=data/raw/smap
WORLDCOVER_DATA_DIR=data/raw/worldcover

# Models Directory
MODELS_TRAINED_DIR=models/trained
MODELS_METADATA_DIR=models/metadata

# Geospatial Parameters (North-Eastern Region of India - NER)
# Bounding Box: [min_lon, min_lat, max_lon, max_lat]
NER_BBOX_MIN_LON=87.8
NER_BBOX_MIN_LAT=21.9
NER_BBOX_MAX_LON=97.4
NER_BBOX_MAX_LAT=29.5

# Coordinate Reference Systems
CRS_GEOGRAPHIC=EPSG:4326
CRS_PROJECTED_UTM=EPSG:32646

# Risk Fusion Thresholds (Prototype calibration values)
SUSCEPTIBILITY_HIGH_THRESHOLD=0.70
SUSCEPTIBILITY_MOD_THRESHOLD=0.40

TRIGGER_HIGH_THRESHOLD=70.0
TRIGGER_MOD_THRESHOLD=40.0

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
